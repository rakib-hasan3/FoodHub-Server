// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Provider_Profile {
  id              String  @id @default(uuid())
  is_active       Boolean @default(true)
  user_id         String  @unique
  user            User    @relation(fields: [user_id], references: [id])
  restaurant_name String  @db.VarChar(150)
  address         String  @db.VarChar(250)
  contact_number  String
  image           String?
  meals           Meals[]

  @@index([user_id])
}

model Orders {
  id          String @id @default(uuid())
  customer_id String

  delivery_address String
  total_price      Decimal       @db.Decimal(10, 2)
  status           OrderStatus   @default(PLACED)
  created_at       DateTime      @default(now())
  orderItems       Order_items[]

  @@index([customer_id])
}

enum OrderStatus {
  PLACED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

model Meals {
  id              String           @id @default(uuid())
  
  // এই দুটি লাইন যোগ করা হয়েছে (Foreign Keys)
  provider_id     String           
  category_id     String           

  // রিলেশনগুলো এখানে ডিফাইন করা আছে
  provider        Provider_Profile @relation(fields: [provider_id], references: [id])
  category        Categories       @relation(fields: [category_id], references: [id])
  
  name            String           @db.VarChar(100)
  status          MealsStatus      @default(AVAILABLE)
  description     String           @db.Text
  price           Decimal          @db.Decimal(10, 2)
  image_url       String
  rating          Float            @default(0)
  totalReviews    Int              @default(0)
  featured        Boolean          @default(false)
  trending        Boolean          @default(false)
  orderCount      Int              @default(0)
  discountPercent Int              @default(0)
  discountPrice   Decimal?         @db.Decimal(10, 2)
  offerText       String?
  offerExpiresAt  DateTime?
  isDiscounted    Boolean          @default(false)
  preparationTime String?
  calories        Int?
  spiceLevel      String?
  servingSize     String?
  isAvailable     Boolean          @default(true)
  ingredients     String[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  reviews         reviews[]
  orderItems      Order_items[]

  @@index([provider_id])
  @@index([category_id])
  @@index([featured])
  @@index([trending])
  @@index([isAvailable])
  @@index([spiceLevel])
  @@index([rating])
  @@index([orderCount])
  @@index([createdAt])
  @@index([isDiscounted])
  @@index([offerExpiresAt])
}

enum MealsStatus {
  AVAILABLE
  UNAVAILABLE
}

model Categories {
  id    String  @id @default(uuid())
  name  String  @db.VarChar(150)
  image String?
  meals Meals[]
}

model Order_items {
  id             String  @id @default(uuid())
  customer_id    String
  customer       User    @relation(fields: [customer_id], references: [id])
  meal_id        String
  meal           Meals   @relation(fields: [meal_id], references: [id])
  quantity       Int
  price_at_order Decimal @db.Decimal(10, 2)
  orders         Orders? @relation(fields: [ordersId], references: [id])
  ordersId       String?

  @@index([customer_id])
  @@index([meal_id])
}

model reviews {
  id          String   @id @default(uuid())
  customer_id String
  customer    User     @relation(fields: [customer_id], references: [id])
  meal_id     String
  meal        Meals    @relation(fields: [meal_id], references: [id])
  rating      Int
  comment     String
  created_at  DateTime @default(now())

  @@index([customer_id])
}

model User {
  id              String            @id @default(uuid())
  name            String
  email           String
  password        String?
  emailVerified   Boolean           @default(false)
  image           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  orderItems      Order_items[]
  reviews         reviews[]
  providerProfile Provider_Profile?

  role   UserRole @default(USER)
  phone  String?
  status String?  @default("ACTIVE")

  @@unique([email])
  @@map("user")
}

enum UserRole {
  USER
  ADMIN
  PROVIDER
}



